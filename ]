@import 'node_modules/modern-normalize/modern-normalize.css';
@import 'fonts/stylesheet.css';

body {
    display: flex;
    height: 100vh;
}

.left-page {
    flex:1;
    background: url("imgs/halie-west-25xggax4bSA-unsplash.jpg") 0% / cover no-repeat;
    color:white;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.title {
    height: 150px;
    padding:20px;
    margin: 180px 0 0 0;
    background-color: rgb(0,0, 0, 0.5);
    display:flex;
    justify-content: center;
    align-items: center;
}

.left-page h1 {
    font-family: Norse;
    margin: 0; 
    font-size: 80px;
}

.title img{
    height: 100%;    
}

.left-page footer {
    display: flex;
    justify-content: center;
}

footer a {
    color: white;
}

.right-page {
    flex:2;
    background-color: rgb(243, 243, 243);
    display: flex;
    flex-direction: column;
}

.sign-up-text {
    margin: 100px 30px 40px 30px;
    font-weight: 600;
}

.sign-up-form {
    width: 100%;
    background-color: white;
    box-shadow: 0px 3px 5px lightgray;
}

fieldset {
    display: flex;
    flex-wrap: wrap;
    width: 500px;
    border:none;
}

legend {
    font-size: 50px;
    font-weight: 500;
}

label{
    display: block;
}

button {
    width: 200px;
}